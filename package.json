{
  "name": "hive",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/hived/src/main.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "tsc -b && bun run --cwd apps/web build",
    "typecheck": "tsc -b",
    "start": "bun apps/hived/src/main.ts",
    "test": "bun test apps packages",
    "test:coverage": "bun test --coverage apps packages",
    "db:generate": "cd apps/hived && drizzle-kit generate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0"
}
